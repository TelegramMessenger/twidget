# cmake -DREPLAY=<twidget_replay> -DRECORDING=<file> -DSOURCE=<name> -DNEEDS=<a,b,...> [-DRECORDER=<program>] [-DSESSIONS=<n>] [-DMESSAGE_BYTES=<n>] [-DMAX_BYTES=<n>] -P parity.cmake: one source replayed through the two ends, then caught perturbed: a list, a Backend call and, with keys in NEEDS, a paint key.
cmake_minimum_required(VERSION 3.22)
foreach(required REPLAY RECORDING SOURCE NEEDS)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "parity.cmake needs -D${required}")
    endif()
endforeach()
set(caps "")
if(DEFINED MESSAGE_BYTES AND NOT MESSAGE_BYTES STREQUAL "")
    set(caps --message-bytes "${MESSAGE_BYTES}")
endif()

# The recorder's own checks are printed, never gated: twidget_core gates them. Only core may end with failed checks (1); 2, a signal or no start gates.
if(DEFINED RECORDER AND NOT RECORDER STREQUAL "")
    get_filename_component(folder "${RECORDING}" DIRECTORY)
    file(MAKE_DIRECTORY "${folder}")
    file(REMOVE "${RECORDING}")
    execute_process(COMMAND "${RECORDER}" "${RECORDING}" RESULT_VARIABLE recorded OUTPUT_FILE "${RECORDING}.log")
    file(READ "${RECORDING}.log" log)
    string(REGEX MATCHALL "(^|\n)PASS " passes "${log}")
    string(REGEX MATCHALL "(^|\n)FAIL " fails "${log}")
    string(REGEX MATCH "recorded [0-9]+ sessions, [0-9]+ steps" counts "${log}")
    list(LENGTH passes pass_count)
    list(LENGTH fails fail_count)
    message(STATUS "${SOURCE}: ${RECORDER} exited ${recorded}: ${counts}; its own checks ${pass_count} PASS, ${fail_count} FAIL (output in ${RECORDING}.log)")
    if(SOURCE STREQUAL "core")
        set(allowed 0 1)
    else()
        set(allowed 0)
    endif()
    if(NOT recorded IN_LIST allowed)
        message(FATAL_ERROR "${SOURCE}: the recording failed: ${recorded}")
    endif()
endif()

if(NOT EXISTS "${RECORDING}")
    message(FATAL_ERROR "${SOURCE}: there is no recording at ${RECORDING}")
endif()
if(DEFINED MAX_BYTES AND NOT MAX_BYTES STREQUAL "")
    if(NOT MAX_BYTES MATCHES "^[0-9]+$")
        message(FATAL_ERROR "parity.cmake needs a byte count in -DMAX_BYTES, not ${MAX_BYTES}")
    endif()
    file(SIZE "${RECORDING}" size)
    if(size GREATER MAX_BYTES)
        message(FATAL_ERROR "${SOURCE}: ${RECORDING} is ${size} bytes, past its budget of ${MAX_BYTES}")
    endif()
    message(STATUS "${SOURCE}: the recording is ${size} bytes, within its budget of ${MAX_BYTES}")
endif()

set(options --source "${SOURCE}" --needs "${NEEDS}")
if(DEFINED SESSIONS AND NOT SESSIONS STREQUAL "")
    list(APPEND options --sessions "${SESSIONS}")
endif()
execute_process(COMMAND "${REPLAY}" "${RECORDING}" ${options} ${caps} RESULT_VARIABLE replayed)
if(NOT replayed STREQUAL "0")
    message(FATAL_ERROR "${SOURCE}: the replay through the two ends failed: ${replayed}")
endif()
set(perturbations list call)
if(NEEDS MATCHES "(^|,)keys(,|$)")
    list(APPEND perturbations key)
endif()
foreach(perturbed IN LISTS perturbations)
    execute_process(COMMAND "${REPLAY}" "${RECORDING}" --source "${SOURCE}" ${caps} --perturb ${perturbed} RESULT_VARIABLE caught)
    if(NOT caught STREQUAL "0")
        message(FATAL_ERROR "${SOURCE}: a perturbed ${perturbed} is not caught where it was changed: ${caught}")
    endif()
endforeach()
if(DEFINED RECORDER AND NOT RECORDER STREQUAL "")
    file(REMOVE "${RECORDING}")
endif()
message(STATUS "${SOURCE}: the two ends replay every step as recorded, and every perturbation (${perturbations}) is caught")
