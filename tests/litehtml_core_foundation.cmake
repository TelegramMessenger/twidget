# cmake -DNM=<nm> -DLIBRARY=<archive> -DPROGRAM=<litehtml consumer> -DNO_CORE_FOUNDATION=<ON|OFF> -P litehtml_core_foundation.cmake: checks the switch against imports and load commands.
execute_process(COMMAND "${NM}" -u "${LIBRARY}" OUTPUT_VARIABLE symbols RESULT_VARIABLE status)
if(NOT status EQUAL 0 OR symbols STREQUAL "")
    message(FATAL_ERROR "nm -u ${LIBRARY} failed: ${status}")
endif()
string(REPLACE "\n" ";" imports "${symbols}")
list(FILTER imports INCLUDE REGEX "^_+k?CF")
list(REMOVE_DUPLICATES imports)
execute_process(COMMAND otool -L "${PROGRAM}" OUTPUT_VARIABLE dylibs RESULT_VARIABLE status)
if(NOT status EQUAL 0 OR dylibs STREQUAL "")
    message(FATAL_ERROR "otool -L ${PROGRAM} failed: ${status}")
endif()
string(FIND "${dylibs}" "/CoreFoundation.framework/" linked)
message(STATUS "${LIBRARY} imports from CoreFoundation: ${imports}")
if(NO_CORE_FOUNDATION)
    if(imports)
        message(FATAL_ERROR "litehtml built without CoreFoundation imports ${imports}")
    endif()
    if(NOT linked EQUAL -1)
        message(FATAL_ERROR "${PROGRAM} links CoreFoundation:\n${dylibs}")
    endif()
else()
    foreach(symbol _CFDateFormatterCreateDateFormatFromTemplate _CFLocaleCopyCurrent _CFRelease _CFStringGetCString ___CFConstantStringClassReference)
        list(FIND imports "${symbol}" index)
        if(index EQUAL -1)
            message(FATAL_ERROR "litehtml does not import ${symbol} for the locale's date pattern")
        endif()
    endforeach()
    if(linked EQUAL -1)
        message(FATAL_ERROR "${PROGRAM} does not link CoreFoundation:\n${dylibs}")
    endif()
endif()
