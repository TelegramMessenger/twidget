</style>
<p>Try one of these 👇</p>
<div><span class="ask">Show a table</span><span class="ask">Show a card</span><span class="ask">Draw a chart</span></div>
<script>
const TABS = [['table', 'Show a table'], ['card', 'Show a card'], ['chart', 'Draw a chart']];
const FEATURES = [
  { name: 'Block & inline layout', ok: 2, tip: 'Paragraphs, lists and inline formatting: what every bubble is made of.' },
  { name: 'Tables, floats, positioning', ok: 2, tip: 'rowspan, colspan, float: left, position: relative and absolute.' },
  { name: 'Flexbox', ok: 2, tip: 'justify-content, align-items, flex-wrap and flex-grow all work.' },
  { name: 'Gradients (linear/radial/conic)', ok: 2, tip: 'All three. Rings and pie charts are conic gradients.' },
  { name: 'JavaScript', ok: 1, tip: 'A sandboxed <script> per message with render() and onAction(). This card is one.' },
  { name: 'CSS grid', ok: 0, tip: 'Not supported: use flex or a table instead.' },
  { name: 'CSS transitions', ok: 0, tip: 'Not supported: animate from a script with tween() and transition().' },
];
const MARK = ['❌', '✅ sandboxed', '✅'];
const ROW = 26;
const DAYS = ['M', 'T', 'W', 'T', 'F', 'S', 'S'];
const LONG = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];
const WEEKS = { now: [124, 192, 158, 248, 217, 87, 56], last: [110, 150, 186, 170, 205, 120, 64] };
const REVIEWS = [[5, 72], [4, 18], [3, 6], [2, 3], [1, 1]];

let cur = null, intro = 0;
let order = FEATURES.map((_, i) => i), sortKey = null, sortDir = 1, shift = {}, sel = null;
let nights = 3, fav = false, booked = false, face = 'front', flipping = false;
let week = 'now', bar = null, hs = Array(7).fill(0), barRun = 0;
const move = { p: 1 }, rowsIn = { v: 1 }, price = { v: 420 }, heart = { s: 1 }, flip = { w: 1 }, rev = { k: 1 };

setTimeout(() => animate(700, (_, t) => { intro = t; }, ease.linear), 250);

function growBars() {
  const from = hs.slice(), to = WEEKS[week], me = ++barRun;
  animate(800, (_, t) => {
    if (me === barRun) hs = to.map((v, i) => lerp(from[i], v, ease.outCubic(clamp((t * 800 - i * 50) / 500, 0, 1))));
  }, ease.linear);
}

function resort(key) {
  const before = order.slice();
  if (sortKey === key) sortDir = -sortDir; else { sortKey = key; sortDir = 1; }
  order = FEATURES.map((_, i) => i).sort((a, b) => {
    const A = FEATURES[a], B = FEATURES[b];
    const c = key === 'name' ? A.name.localeCompare(B.name) : B.ok - A.ok;
    return c * sortDir || a - b;
  });
  shift = {};
  order.forEach((id, idx) => { shift[id] = (before.indexOf(id) - idx) * ROW; });
  move.p = 0;
  tween(move, { p: 1 }, 520, ease.outCubic);
}

async function flipCard() {
  if (flipping) return;
  flipping = true;
  await tween(flip, { w: 0 }, 160, ease.inQuad);
  face = face === 'front' ? 'back' : 'front';
  if (face === 'back') { rev.k = 0; tween(rev, { k: 1 }, 700, ease.outCubic); }
  await tween(flip, { w: 1 }, 220, ease.outCubic);
  flipping = false;
}

function onAction(name, value) {
  if (name === 'tab') {
    if (value === cur || !TABS.some(t => t[0] === value)) return;
    const ids = TABS.map(t => t[0]);
    transition(cur === null ? 'slide-down' : ids.indexOf(value) > ids.indexOf(cur) ? 'slide-left' : 'slide-right');
    cur = value;
    if (value === 'chart') { hs = hs.map(() => 0); growBars(); }
    if (value === 'table') { rowsIn.v = 0; tween(rowsIn, { v: 1 }, 700, ease.linear); }
  } else if (name === 'close') {
    transition('slide-up');
    cur = null;
  } else if (name === 'sort') resort(value === 'ok' ? 'ok' : 'name');
  else if (name === 'row') {
    transition('fade');
    const id = Number(value);
    sel = sel === id ? null : id;
  } else if (name === 'fav') {
    fav = !fav;
    heart.s = 0.3;
    tween(heart, { s: 1 }, 450, ease.outBack);
  } else if (name === 'nights' && !booked) {
    nights = clamp(nights + Number(value), 1, 7);
    tween(price, { v: nights * 140 }, 450, ease.outCubic);
  } else if (name === 'book' && !booked) { transition('pop'); booked = true; }
  else if (name === 'unbook' && booked) { transition('fade'); booked = false; }
  else if (name === 'flip') flipCard();
  else if (name === 'week') {
    if (value === week || !WEEKS[value]) return;
    week = value;
    growBars();
  } else if (name === 'bar') {
    const i = Number(value);
    bar = bar === i ? null : i;
  }
}

function table() {
  const arrow = k => sortKey === k ? (sortDir > 0 ? ' ▲' : ' ▼') : ' ↕';
  const rows = order.map((id, idx) => {
    const f = FEATURES[id];
    const off = Math.round((shift[id] || 0) * (1 - move.p));
    const left = Math.round((1 - ease.outCubic(clamp(rowsIn.v * 1.6 - idx * 0.09, 0, 1))) * 330);
    return `<div class="tr ${idx % 2 ? 'alt' : ''} ${sel === id ? 'sel' : ''}" data-action="row" data-value="${id}" style="top: ${off}px; left: ${left}px"><span class="grow">${esc(f.name)}</span><span class="sup">${MARK[f.ok]}</span></div>`;
  }).join('');
  const f = sel !== null ? FEATURES[sel] : null;
  return `<div class="tbl"><div class="thd"><span class="grow srt" data-action="sort" data-value="name">Feature${arrow('name')}</span><span class="sup srt" data-action="sort" data-value="ok">Supported${arrow('ok')}</span></div>
    <div class="rws">${rows}</div></div>
    <div class="tip">${f ? `💡 <b>${esc(f.name)}</b> · ${esc(f.tip)}` : '<span class="muted">Click a header to sort, a row for details</span>'}</div>`;
}

function front() {
  const n = nights, plural = n > 1 ? 's' : '';
  const buy = booked
    ? `<span class="t-green"><b>✓ Booked</b> · ${n} night${plural} · $${n * 140}</span><span class="undo" data-action="unbook">Undo</span>`
    : `<span><b style="font-size: 18px">$${Math.round(price.v)}</b> <s class="small muted">$${n * 170}</s></span>
       <span><span class="stp" data-action="nights" data-value="-1">−</span><span class="small" style="display: inline-block; width: 28px; text-align: center">${n} n</span><span class="stp" data-action="nights" data-value="1">+</span></span>
       <span class="book" data-action="book">Book</span>`;
  return `<div class="card fc">
    <div style="position: relative; height: 120px"><img src="app:dunes" width="298" height="120" style="display: block; border-radius: 13px 13px 0 0">
      <span class="fav" data-action="fav"><span style="font-size: ${Math.max(1, Math.round(16 * heart.s))}px">${fav ? '❤️' : '🤍'}</span></span></div>
    <div style="padding: 9px 14px 0 14px">
      <div class="caps t-orange">Travel · ${n} night${plural}</div>
      <div style="font-size: 17px; font-weight: 700">Desert Retreat, Merzouga</div>
      <div class="small muted" style="margin: 2px 0 9px 0">★★★★☆ 4.6 · 1,204 reviews · <span class="lnk" data-action="flip">Details ↻</span></div>
      <div class="row between">${buy}</div>
    </div></div>`;
}

function back() {
  const rows = REVIEWS.map(([s, p]) => `<div class="row tiny"><span style="width: 22px">${s}★</span><div class="rb"><div style="width: ${(p * rev.k).toFixed(1)}%"></div></div><span class="muted" style="width: 34px; text-align: right">${p}%</span></div>`).join('');
  return `<div class="card fc"><div style="padding: 12px 14px">
    <div class="row between"><b>What's included</b><span class="lnk small" data-action="flip">↻ Photo</span></div>
    <div class="small" style="margin-top: 4px; line-height: 1.6">🐪 Camel trek at sunset<br>⛺ Luxury tent with en-suite<br>🍲 Dinner &amp; breakfast<br>🌌 Stargazing with a guide</div>
    <div class="caps" style="margin: 8px 0 2px 0">Reviews · 4.6 ★</div>${rows}
  </div></div>`;
}

function card() {
  const W = 300, w = Math.max(0, Math.round(W * flip.w)), off = Math.round((W - w) / 2);
  return `<div style="height: 240px; padding-left: ${off}px"><div style="width: ${w}px; height: 240px; overflow: hidden"><div style="width: ${W}px; margin-left: ${-off}px">${face === 'front' ? front() : back()}</div></div></div>`;
}

function chart() {
  const data = WEEKS[week], peak = data.indexOf(Math.max(...data));
  const cols = hs.map((v, i) => `<div class="col" data-action="bar" data-value="${i}"><div class="tiny" style="height: 16px">${i === bar ? `<b>${Math.round(v)}</b>` : '&nbsp;'}</div><div class="b ${i === bar ? 'sel' : i === peak ? 'pk' : ''}" style="height: ${Math.max(2, Math.round(v / 260 * 96))}px"></div></div>`).join('');
  const days = DAYS.map((d, i) => `<span class="col tiny ${i === peak ? 't-purple' : 'muted'}">${i === peak ? `<b>${d}</b>` : d}</span>`).join('');
  let info = `<span class="muted">Click a bar · busiest day is ${LONG[peak]}</span>`;
  if (bar !== null) {
    const v = data[bar], other = WEEKS[week === 'now' ? 'last' : 'now'][bar], d = Math.round((v - other) / other * 100);
    info = `<b>${LONG[bar]}</b> · ${v} messages · <span class="${d >= 0 ? 't-green' : 't-red'}">${d >= 0 ? '+' : ''}${d}%</span> <span class="muted">vs ${week === 'now' ? 'last' : 'this'} week</span>`;
  }
  return `<div class="row between"><b>Weekly messages</b><span><span class="seg ${week === 'now' ? 'on' : ''}" data-action="week" data-value="now">This week</span> <span class="seg ${week === 'last' ? 'on' : ''}" data-action="week" data-value="last">Last week</span></span></div>
    <div class="bars">${cols}</div><div class="days">${days}</div>
    <div class="small" style="margin-top: 6px">${info}</div>
    <div class="tiny muted">Total <b>${Math.round(hs.reduce((s, v) => s + v, 0))}</b> · pure HTML/CSS bars</div>`;
}

function render() {
  const chips = TABS.map(([id, label], i) => {
    const e = clamp((intro * 700 - i * 110) / 350, 0, 1);
    const style = e < 1 ? ` style="top: ${Math.round((1 - ease.outBack(e)) * 12)}px; border-color: ${alpha('#2cb67d', e)}; color: ${alpha('#2cb67d', e)}"` : '';
    return `<span class="ask ${cur === id ? 'on' : ''}" data-action="tab" data-value="${id}"${style}>${label}</span>`;
  }).join('') + (cur ? '<span class="ask x" data-action="close">✕</span>' : '');
  const body = cur === 'table' ? table() : cur === 'card' ? card() : cur === 'chart' ? chart() : '';
  return `<div class="pg"><p style="margin-bottom: 4px">${cur ? 'Here you go, all live 👇' : 'Try one of these 👇'}</p>
    <div>${chips}</div>${body ? `<div class="stage">${body}</div>` : ''}</div>`;
}
</script>
