<style>
  .pgw { width: 420px; max-width: 100%; }
  .pgw .hd { display: flex; align-items: center; padding: 14px; border-radius: 13px 13px 0 0; background: linear-gradient(135deg, #7f5af0, #2cb67d); color: #ffffff; }
  .pgw .logo { margin-right: 12px; border-radius: 11px; border: 2px solid rgba(255,255,255,0.6); }
  .pgw .tabs { display: flex; margin: 10px 16px 0 16px; padding: 2px; border-radius: 9px; background-color: rgba(127,127,127,0.14); }
  .pgw .tab { flex-grow: 1; padding: 4px 0; border-radius: 7px; text-align: center; font-size: 12.5px; font-weight: 600; }
  .pgw .tab:hover { background-color: rgba(127,127,127,0.16); }
  .pgw .tab.on { background-color: #7f5af0; color: #ffffff; }
  .pgw .bd { padding: 8px 16px 14px 16px; font-size: 13px; }
  .pgw .list { overflow: hidden; margin: 0 -6px; }
  .pgw .tip { display: flex; position: relative; padding: 5px 6px; border-radius: 8px; }
  .pgw .tip:hover { background-color: rgba(127,127,127,0.09); }
  .pgw .ck { display: inline-block; width: 18px; height: 18px; margin-right: 8px; border-radius: 9px; text-align: center; line-height: 18px; font-size: 10.5px; font-weight: 800; }
  .pgw .tx { flex-grow: 1; width: 340px; }
  .pgw .meter { height: 6px; margin-top: 4px; border-radius: 3px; background-color: rgba(127,127,127,0.2); }
  .pgw .meter div { height: 6px; border-radius: 3px; background: linear-gradient(90deg, #7f5af0, #2cb67d); }
  .pgw .demo { display: flex; align-items: center; justify-content: space-between; margin-top: 8px; padding: 8px 10px; border-radius: 10px; background-color: rgba(127,90,240,0.10); }
  .pgw .num { display: inline-block; width: 44px; height: 30px; line-height: 30px; text-align: center; font-weight: 800; }
  .pgw .thumbs { display: flex; justify-content: space-between; margin-top: 6px; }
  .pgw .th { padding: 2px; border-radius: 9px; }
  .pgw .th:hover { background-color: rgba(127,127,127,0.25); }
  .pgw .th.on { background-color: #7f5af0; }
  .pgw .prev { position: relative; height: 120px; margin-top: 8px; overflow: hidden; border-radius: 10px; background-color: rgba(127,127,127,0.12); text-align: center; }
  .pgw .prev code { position: absolute; left: 8px; top: 92px; background-color: rgba(0,0,0,0.55); color: #ffffff; }
  .pgw .syms { display: flex; margin-top: 6px; }
  .pgw .sym { width: 40px; height: 34px; margin-right: 6px; border-radius: 9px; text-align: center; line-height: 34px; background-color: rgba(127,127,127,0.10); }
  .pgw .sym:hover { background-color: rgba(127,127,127,0.22); }
  .pgw .sym.on { background-color: rgba(127,90,240,0.22); }
  .pgw .note { margin-top: 10px; padding: 8px 10px; border-radius: 8px; border-left: 3px solid #007aff; background-color: rgba(0,122,255,0.08); font-size: 12px; }
</style>
<div class="card pgw"><div class="hd"><img class="logo" src="app:logo" width="44" height="44"><div><div style="font-size: 18px; font-weight: 800">Welcome to the playground</div><div class="small" style="color: rgba(255,255,255,0.85)">Every bubble in this app is an HTML document rendered by litehtml</div></div></div><div class="bd">Type HTML in the composer and press <b>Return</b>.</div></div>
<script>
const TABS = [['basics', '✍️ Basics'], ['scripts', '⚡️ Scripts'], ['assets', '🖼 Assets']];
const BASICS = [
  'Type HTML in the composer and press <b>Return</b> (Shift-Return for a newline).',
  'Use <b>Insert Snippet</b> for ready-made cards, tables, buttons…',
  'Toggle <b>Send as Them</b> to see the incoming bubble style.',
  'Messages show fullsize, without a bubble. Wrap one in <code>&lt;div class="widget"&gt;</code> to show it inside a bubble.',
  '<b>Hover</b> a bubble for parse/layout timings, <b>right-click</b> to view its source.',
  '<b>⌘O</b> opens any <code>.html</code> file as a message, or a <code>.chat</code> conversation.',
];
const SCRIPTS = [
  'Add a <code>&lt;script&gt;</code>: <code>render()</code> returns the HTML, <code>onAction(name, value)</code> handles clicks on <code>data-action</code>.',
  'Animate with <code>tween()</code>, <code>animate()</code> and <code>transition()</code>. litehtml itself has no CSS transitions.',
  '<b>Without JS:</b> <code>chat:toggle?key=x</code> and <code>chat:select?key=tab-2&amp;group=tab</code> links add <code>on-x</code> classes to the bubble\'s &lt;body&gt;.',
  '<b>CSS kit</b> in every bubble (dark-mode aware): <code>.card .pad .row .badge .btn .chip .panel .muted kbd</code>.',
];
const IMAGES = ['aurora', 'ocean', 'dunes', 'forest', 'sunset', 'map', 'logo'];
const SYMBOLS = [['heart.fill', 'ff2d55'], ['star.fill', 'ff9500'], ['bolt.fill', 'ffcc00'], ['leaf.fill', '34c759'], ['drop.fill', '007aff'], ['moon.stars.fill', 'af52de']];
let tab = 'basics', intro = 0, count = 0, last = null, img = 'aurora', sym = 0;
const tried = new Set(), meter = { v: 0 }, pop = { s: 1 }, symPop = { s: 1 }, checks = BASICS.map(() => ({ s: 1 }));

setTimeout(() => animate(900, (_, t) => { intro = t; }, ease.linear), 250);

const stagger = i => ease.outCubic(clamp((intro * 900 - i * 80) / 420, 0, 1));

function basics() {
  const rows = BASICS.map((t, i) => {
    const on = tried.has(i), s = checks[i].s;
    const d = Math.max(1, Math.round(18 * s));
    const ck = on
      ? `<span class="ck" style="width: ${d}px; height: ${d}px; line-height: ${d}px; margin: ${(18 - d) / 2}px ${8 + (18 - d) / 2}px 0 ${(18 - d) / 2}px; background-color: #2cb67d; color: #ffffff">✓</span>`
      : `<span class="ck" style="background-color: rgba(127,90,240,0.16); color: #7f5af0">${i + 1}</span>`;
    return `<div class="tip" data-action="try" data-value="${i}" style="left: ${Math.round((1 - stagger(i)) * 440)}px">${ck}<span class="tx">${t}</span></div>`;
  }).join('');
  const n = tried.size;
  return `<div class="list">${rows}</div>
    <div class="row between small" style="margin-top: 8px"><span class="muted">${n === BASICS.length ? '🎉 You tried them all' : 'Click a tip once you\'ve tried it'}</span><b>${n} / ${BASICS.length}</b></div>
    <div class="meter"><div style="width: ${(meter.v * 100).toFixed(1)}%"></div></div>`;
}

function scripts() {
  const rows = SCRIPTS.map((t, i) => `<div class="tip" style="left: ${Math.round((1 - stagger(i)) * 440)}px"><span class="ck" style="background-color: rgba(44,182,125,0.18); color: #2cb67d">${i + 1}</span><span class="tx">${t}</span></div>`).join('');
  const size = Math.round(20 * pop.s);
  return `<div class="list">${rows}</div>
    <div class="demo"><span class="small"><b>This card is a script too.</b><br><span class="muted">${last === null ? 'Try the buttons →' : `last call: onAction('add', '${last}')`}</span></span>
      <span><button data-action="add" data-value="-1">−</button><span class="num ${count > 0 ? 't-green' : count < 0 ? 't-red' : ''}" style="font-size: ${size}px">${count}</span><button class="primary" data-action="add" data-value="1">+</button></span></div>`;
}

function assets() {
  const thumbs = IMAGES.map(n => `<span class="th ${n === img ? 'on' : ''}" data-action="img" data-value="${n}"><img src="app:${n}" width="44" height="44" style="border-radius: 7px"></span>`).join('');
  const big = img === 'logo' ? '<img src="app:logo" width="120" height="120">' : `<img src="app:${img}" width="388" height="120">`;
  const syms = SYMBOLS.map(([name, c], i) => {
    const d = i === sym ? Math.max(1, Math.round(22 * symPop.s)) : 20;
    return `<span class="sym ${i === sym ? 'on' : ''}" data-action="sym" data-value="${i}"><img src="sf:${name}?size=22&color=${c}" width="${d}" height="${d}"></span>`;
  }).join('');
  const [sn, sc] = SYMBOLS[sym];
  return `<div class="small muted">Bundled pictures · click one</div>
    <div class="thumbs">${thumbs}</div>
    <div class="prev">${big}<code>app:${img}</code></div>
    <div class="small muted" style="margin-top: 10px">SF Symbols · any name, size and colour</div>
    <div class="syms">${syms}</div>
    <div style="margin-top: 6px"><code>sf:${sn}?size=24&amp;color=${sc}</code></div>
    <div class="note">Also <code>data:</code> URIs (PNG/JPEG/SVG). Links: <code>https:</code> opens the browser, <code>chat:send?text=…</code> sends a reply.</div>`;
}

function render() {
  const tabs = TABS.map(([id, label]) => `<span class="tab ${tab === id ? 'on' : ''}" data-action="tab" data-value="${id}">${label}</span>`).join('');
  const body = tab === 'basics' ? basics() : tab === 'scripts' ? scripts() : assets();
  return `<div class="card pgw">
    <div class="hd"><img class="logo" src="app:logo" width="44" height="44"><div>
      <div style="font-size: 18px; font-weight: 800">Welcome to the playground</div>
      <div class="small" style="color: rgba(255,255,255,0.85)">Every bubble in this app is an HTML document rendered by litehtml</div></div></div>
    <div class="tabs">${tabs}</div>
    <div class="bd">${body}</div>
  </div>`;
}

function onAction(name, value) {
  if (name === 'tab') {
    if (value === tab) return;
    const order = TABS.map(t => t[0]);
    transition(order.indexOf(value) > order.indexOf(tab) ? 'slide-left' : 'slide-right');
    tab = value;
  } else if (name === 'try') {
    const i = Number(value);
    if (tried.has(i)) tried.delete(i);
    else { tried.add(i); checks[i].s = 0; tween(checks[i], { s: 1 }, 420, ease.outBack); }
    tween(meter, { v: tried.size / BASICS.length }, 500, ease.outCubic);
  } else if (name === 'add') {
    count += Number(value);
    last = value;
    pop.s = 1.5;
    tween(pop, { s: 1 }, 420, ease.outBack);
  } else if (name === 'img') {
    if (value === img || !IMAGES.includes(value)) return;
    transition('fade');
    img = value;
  } else if (name === 'sym') {
    sym = clamp(Number(value), 0, SYMBOLS.length - 1);
    symPop.s = 0.4;
    tween(symPop, { s: 1 }, 420, ease.outBack);
  }
}
</script>

