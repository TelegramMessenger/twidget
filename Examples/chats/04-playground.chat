  .pg { width: 320px; max-width: 100%; }
  .pg .ask { display: inline-block; position: relative; margin: 2px 4px 2px 0; padding: 3px 12px; border-radius: 14px; border: 1px solid #2cb67d; color: #2cb67d; }
  .pg .ask:hover { background-color: rgba(44,182,125,0.14); }
  .pg .ask.on { background-color: #2cb67d; color: #ffffff; }
  .pg .ask.x { padding: 3px 9px; border-color: rgba(127,127,127,0.4); color: #8e8e93; }
  .pg .stage { margin-top: 8px; }
  .pg .tbl { overflow: hidden; border-radius: 10px; border: 1px solid rgba(127,127,127,0.25); }
  .pg .thd { display: flex; align-items: center; height: 28px; padding: 0 10px; background-color: rgba(44,182,125,0.18); font-size: 12.5px; font-weight: 700; }
  .pg .srt:hover { color: #2cb67d; }
  .pg .rws { height: 182px; }
