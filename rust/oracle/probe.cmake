# tw_probe: `from` replaced by `to` in variable `var`, which must hold it exactly `count` times, or the configure stops (the probes of a copied C++ file follow its text or say so).
function(tw_probe var count from to)
    set(text "${${var}}")
    set(rest "${text}")
    set(found 0)
    string(LENGTH "${from}" length)
    while (TRUE)
        string(FIND "${rest}" "${from}" at)
        if (at EQUAL -1)
            break()
        endif()
        math(EXPR found "${found} + 1")
        math(EXPR at "${at} + ${length}")
        string(SUBSTRING "${rest}" ${at} -1 rest)
    endwhile()
    if (NOT found EQUAL count)
        message(FATAL_ERROR "${TW_PROBE_WHAT}: `${from}` is in ${var} ${found} times, not ${count}: the probes need updating")
    endif()
    string(REPLACE "${from}" "${to}" text "${text}")
    set(${var} "${text}" PARENT_SCOPE)
endfunction()
